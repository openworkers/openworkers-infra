#
# OPENWORKERS ENVIRONMENT VARIABLES
#

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_SECRET=your-access-secret

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=openworkers
POSTGRES_USER=openworkers
POSTGRES_PASSWORD=your-password

DATABASE_URL=postgresql://openworkers:your-password@postgres:5432/openworkers

# Postgate (API uses this to access the OpenWorkers database)
POSTGATE_URL=http://postgate:6080
POSTGATE_TOKEN=pg_your-token-here
# Allows OpenWorkers API to create deterministic system tokens for Postgate
POSTGATE_SYSTEM_TOKEN_SECRET=postgate-system-token-randomly-generated-secret

# TLS files on the host; compose.prod.yml mounts them, and compose.tls.yml in dev
HTTP_TLS_CERTIFICATE=/path/to/ssl.crt
HTTP_TLS_KEY=/path/to/ssl.key

DASHBOARD_HOSTS=dash.openworkers.com,dash.openworkers.dev,dash.dev.localhost,dash.dev.kube
API_WORKER_NAME=openworkers-api
WORKER_DOMAINS=workers.rocks,workers.dev.localhost
